# Copy to .env and fill in. .env is in .gitignore – never commit it.

# --- Telegram (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Public channel(s) that receive every new tender (the bot must be an admin there)
TELEGRAM_CHANNELS=@your_channel
# Your own Telegram chat id(s): can send STATS to the bot and get a morning report
ADMIN_CHAT_IDS=

# --- AI reading of NIT files (optional) ---
# Free: a Google Gemini API key from https://aistudio.google.com (no card needed)
GEMINI_API_KEY=
# Optional alternative: Anthropic Claude API key (used only if no Gemini key is set)
ANTHROPIC_API_KEY=
NIT_DAILY_LIMIT=40
NIT_PER_USER_DAILY=5

# --- WhatsApp Cloud API (optional, Meta developer account) ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=pick-any-random-string
WA_APP_SECRET=
WA_TEMPLATE_NAME=tender_digest
WA_TEMPLATE_LANG=en

# --- Behaviour ---
CLOSING_SOON_DAYS=3
DETAIL_DELAY_MS=1500
MAX_DETAILS_PER_RUN=400
HEADLESS=1
# DRY_RUN=1 prints messages instead of sending them
DRY_RUN=0
